#!/usr/bin/env php
<?php

declare(strict_types=1);

use Beffroi\Tui\Profile\ProfileException;
use Beffroi\Tui\Wiring;

// The one the proxy of Composer names when it installed the program as a dependency, then the one of the program
// installed on its own (apps/tui/vendor), then the monorepo's, which maps it too.
$autoloader = $GLOBALS['_composer_autoload_path'] ?? null;
if (! is_string($autoloader)) {
    $autoloader = is_file(__DIR__ . '/../vendor/autoload.php') ? __DIR__ . '/../vendor/autoload.php' : __DIR__ . '/../../../vendor/autoload.php';
}
require $autoloader;

try {
    $application = Wiring::application(getenv());
} catch (ProfileException $exception) {
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(1);
}

exit($application->run());
